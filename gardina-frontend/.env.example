# Frontend Environment Variables

# Local: copy to .env.local — URL must end with /api (matches Express mount at /api).
# Backend default PORT is 5000 (see gardina-backend/src/server.js); use 3001 if you set PORT=3001.
# VITE_API_URL=http://localhost:5000/api

# Optional: tenant slug when several salons share one API (SaaS). Example: demo
# VITE_ORGANIZATION_SLUG=demo

# Production (set in Vercel). MUST end with /api so paths become .../api/auth/...
# VITE_API_URL=https://api.gardina.kz/api

# Sentry error tracking (optional but recommended for production)
# Get DSN from https://sentry.io → Project Settings → Client Keys
VITE_SENTRY_DSN=
