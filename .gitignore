# Dependencies
node_modules/
__pycache__/
*.pyc

# Environment files (contain secrets)
.env
.env.production
.env.local

# Build outputs
dist/
build/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# SSL certs
certbot/

# Logs
*.log
npm-debug.log*

# Test artifacts
playwright-report/
test-results/
.tmp_i18n_strings.txt
# Playwright auth storage states — contain live access tokens, never commit
specs/.auth/
# Regenerable capture/render artifacts (like build output — keep out of history)
specs/demos/.videos/
remotion-demos/out/
gardina-screens/

# Frontend dev artifacts
dev-dist/
.vercel/

# Stray binaries / one-off files in repo root
/Лого.png
/*.png
.gstack/

# iOS app lives in its own repository (gardina-ios)
gardina-ios/

# Env backups — the `.env` rule above does not match `.env.bak`, and these
# carry DB passwords, JWT secrets and AWS keys.
.env.*
!.env.example

# Playwright MCP scratch output (snapshots, screenshots, console logs)
.playwright-mcp/
