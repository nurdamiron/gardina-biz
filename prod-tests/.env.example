# Gardina production test suite — environment config.
# Copy to .env and fill in. NEVER commit a real .env. NEVER use a real
# customer/admin account here — use an ISOLATED test user/tenant.

# API base URL (include /api). Defaults to production if unset.
# Use GARDINA_BASE_URL — plain BASE_URL collides with a Vite-reserved var and
# is ignored unless it is a full http(s) URL.
#   prod:    https://api.gardina.kz/api
#   staging: https://staging-api.gardina.kz/api   (if available)
#   dev:     http://localhost:5000/api
GARDINA_BASE_URL=https://api.gardina.kz/api

# Isolated test account credentials (phone or email + password).
# Prefer a low-privilege role (e.g. designer) for read-only contract tests.
TEST_LOGIN=
TEST_PASSWORD=
# Optional: tenant slug to disambiguate login when a phone/email exists in
# multiple organizations.
TEST_ORG_SLUG=

# Safety gate. Leave OFF (unset / false) against production.
# Only set true on staging or with a throwaway test tenant. Write tests
# self-clean (delete what they create).
ALLOW_WRITES=false

# Optional tuning.
# LATENCY_BUDGET_MS=3000
# REQUEST_TIMEOUT_MS=15000
# Must be an origin in the backend CORS allowlist to receive ACAO headers.
# CORS_ORIGIN=https://app.gardina.kz
