# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gardina_shtory
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration
JWT_SECRET=your_super_secret_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Configuration (для фото)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@gardina.kz

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# WhatsApp Business API
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Frontend URL (для CORS)
FRONTEND_URL=http://localhost:3000

# Upload limits
MAX_FILE_SIZE=10485760
MAX_FILES_PER_REQUEST=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Web Push (VAPID) - Generate with: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:support@gardina.kz

# APNs (native iOS push) — from the Apple Developer portal. iOS push is disabled
# (log-only) unless KEY_ID + TEAM_ID + KEY_P8 are all set.
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
# Contents of the AuthKey_XXXX.p8 file. Single-line with literal \n between lines,
# or a real multi-line value if your env loader supports it.
APNS_KEY_P8=
APNS_BUNDLE_ID=kz.gardina.app
# false = sandbox (api.sandbox.push.apple.com), true = production
APNS_PRODUCTION=false

# Sentry error tracking (optional but recommended for production)
# Get DSN from https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
