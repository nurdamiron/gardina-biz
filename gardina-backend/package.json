{
  "name": "gardina-backend",
  "version": "1.0.0",
  "description": "Gardina — SaaS backend for curtain salons and ateliers",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --verbose --coverage",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watchAll --verbose",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=unit --coverage",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=integration --runInBand",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --testPathPattern=e2e --runInBand",
    "migrate:saas": "node scripts/run-saas-migration.js",
    "migrate:billing": "node scripts/run-billing-migration.js",
    "migrate:saas-features": "node scripts/run-saas-features-migration.js",
    "db:create": "node scripts/create-rds-database.js",
    "seed": "node src/infrastructure/database/seeders/seed.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write 'src/**/*.js'"
  },
  "keywords": [
    "curtains",
    "erp",
    "ddd",
    "clean-architecture",
    "nodejs"
  ],
  "author": "Gardina",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/lib-storage": "^3.948.0",
    "@sentry/node": "^10.52.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.2",
    "twilio": "^4.19.3",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3"
  }
}
